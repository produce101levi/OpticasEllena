<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@5/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="/flatpickr.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/css/intlTelInput.css">
    <link rel="stylesheet" href="/bulma.min.css">
    <title>Registrar Usuario</title>
</head>
<body class="background">
    <%- include('includes/menu') %>
    <div class="column is-4 is-offset-4 login-wrapper">
        <div class="box px-5 box-wrapper">
            <div class="title has-text-centered">
                Registrar Cuenta
            </div>

            <!-- Mensajes de error o notificación -->
            <% if (error) { %>
                <div class="is-size-7 mb-2">
                    <strong class="is-danger-dark-text"><%= error %></strong>
                </div>
            <% } else if (emailSent) { %>

                <div class="mb-2">
                    <strong><%= emailSent %></strong>
                </div>

            <% } %>
            
            <!-- Form para registrar usuario -->
            <form action="/user/registrar" id="registrarForm" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <!-- Contenedor para inputs de registro de usuario -->
                <div id="inputs" class="mb-3">
                    
                </div>
                
                
                <p class="is-size-6 has-text-centered">¿Ya tienes una cuenta? <a class="is-danger-dark-text" href="/user/login">Iniciar Sesión</a></p>
            </form>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        
    </script>

    <script>
        window.firebaseEnv = {
            apiKey: "<%= apiKey %>",
            authDomain: "<%= authDomain %>",
            projectId: "<%= projectId %>",
            storageBucket: "<%= storageBucket %>",
            messagingSenderId: "<%= messagingSenderId %>",
            appId: "<%= appId %>"
        };
    </script>
    <script type="module" src="/scripts/registrar_cuenta.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/intlTelInput.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/i18n/es/"></script>

</body>
</html>