<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/bulma.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@5/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="/flatpickr.css">
    <title><%if (registrar) {%> Registrar Usuario <% } else { %> Login <% } %></title>
</head>
<body class="background">
    <%- include('includes/menu') %>
    <div class="column is-4 is-offset-4 login-wrapper">
        <div class="box px-5 box-wrapper">
            <div class="title has-text-centered">
                <% if (registrar) { %> Registrar Cuenta <% } else { %> Iniciar Sesión <% } %>
            </div>
            <% if (error) { %>
                <div class="is-size-7 mb-2">
                    <strong class="is-danger-dark-text"><%= error %></strong>
                </div>
            <% } else if (emailSent) { %>

                <div class="mb-2">
                    <strong><%= emailSent %></strong>
                </div>

            <% } %>

            <form action= <% if (registrar) { %> "/user/registrar" <% } else { %>"/user/login" <% } %> method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="field">
                    <p class="control has-icons-left">
                        <input class="input" type="text" name="email" placeholder="Correo" autocomplete="off">
                        <span class="icon is-small is-left">
                            <i class="fas fa-envelope"></i>
                        </span>  
                    </p>
                </div>
                <div class="field">
                    <p id="control_contrasena" class="control has-icons-left has-icons-right">
                        <input class="input" type="password" id="contrasena" name="contrasena" placeholder="Contraseña" autocomplete="off">
                        <span class="icon is-small is-left">
                            <i class="fas fa-lock"></i>
                        </span>
                        <span class="icon is-small is-right" id="mostrar_contrasena">
                            <i class="fas fa-eye-slash" id="ojo"></i>
                        </span>
                    </p>
                </div>
                <div class="is-size-7 mb-2" id="validacion">
                </div>
                <div class="field">
                    <input class="button is-danger-dark is-medium is-fullwidth" type="submit" value= <% if (registrar) { %> "Registrar" <% } else { %> "Iniciar Sesión" <% } %>>
                </div>
                <% if (registrar) { %>
                    <p class="is-size-6 has-text-centered">¿Ya tienes una cuenta? <a class="is-danger-dark-text" href="/user/login">Iniciar Sesión</a></p>
                <% } %>
                <% if (!registrar) { %>
                <div class="field">
                    <a class="button is-light is-medium is-fullwidth" href="/user/registrar">Registrar Usuario</a>
                </div>
                <% } %>
            </form>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        flatpickr("#fecha_nacimiento", {
            locale: {
                firstDayOfWeek: 1,
                weekdays: {
                    shorthand: ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'],
                    longhand: ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'],
                },
                months: {
                    shorthand: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'],
                    longhand: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre']
                }
            }
        });
    </script>

    <% if (registrar) { %>
        <script src="/scripts/registrar_cuenta.js"></script>
    <% } else { %>
        <script src="/scripts/iniciar_sesion.js"></script>
    <% } %>
</body>
</html>